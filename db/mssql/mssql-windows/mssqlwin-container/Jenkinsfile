pipeline {
    agent any

    options {
        disableConcurrentBuilds()
    }

    // Parameter groups:
    //   1. Bastion/image  2. Create VMs  3. Existing hosts  4. Workload  5. Disk
    parameters {
        string(name: 'BASTION_HOST',      defaultValue: 'bastion.example.com', description: '[1] Bastion hostname or IP')
        string(name: 'BASTION_USER',      defaultValue: 'root',                description: '[1] SSH user on bastion')
        string(name: 'SSH_CREDENTIAL_ID', defaultValue: 'bastion-ssh-key',     description: '[1] Jenkins SSH credential ID for bastion')
        string(
            name: 'CONTAINER_IMAGE',
            defaultValue: 'quay.io/ekuric/mssqlwin-benchmark:latest',
            description: '[1] mssqlwin-container image'
        )
        string(name: 'NAMESPACE',         defaultValue: 'default',             description: '[1] OpenShift namespace')
        string(name: 'DESCRIPTION',       defaultValue: 'jenkins-mssql-test',  description: '[1] Test run description')

        // ----- 2. On-demand Windows VMs (snapshot → clone DV) -----
        choice(
            name: 'CREATE_VMS',
            choices: ['false', 'true'],
            description: '[2. Create VMs] Provision before HammerDB (leave HOST_PATTERN empty; needs STORAGE_CLASS + one of WIN_VM_IMAGE / GOLDEN_SNAPSHOT / ORIG_VM)'
        )
        choice(
            name: 'CLEANUP',
            choices: ['false', 'true'],
            description: '[2. Create VMs] Delete managed VMs after test (default keep)'
        )
        string(name: 'VMS',               defaultValue: '1',                   description: '[2. Create VMs] Number of Windows VMs')
        string(name: 'VM_PREFIX',         defaultValue: 'mssql-win',           description: '[2. Create VMs] Name prefix → mssql-win-1..N')
        string(name: 'VM_CPU',            defaultValue: '8',                   description: '[2. Create VMs] vCPU cores')
        string(name: 'VM_MEMORY',         defaultValue: '16Gi',                description: '[2. Create VMs] Memory')
        string(name: 'STORAGE_CLASS',     defaultValue: '',                    description: '[2. Create VMs] StorageClass (required if CREATE_VMS=true)')
        string(name: 'ACCESS_MODE',       defaultValue: 'ReadWriteMany',       description: '[2. Create VMs] PVC access mode')
        string(
            name: 'WIN_VM_IMAGE',
            defaultValue: '',
            description: '[2. Create VMs] HTTP qcow2 URL → source DV → VolumeSnapshot → clones'
        )
        string(
            name: 'GOLDEN_SNAPSHOT',
            defaultValue: '',
            description: '[2. Create VMs] Existing VolumeSnapshot name (skip image import)'
        )
        string(
            name: 'ORIG_VM',
            defaultValue: '',
            description: '[2. Create VMs] Snapshot root PVC of this VM, then clone'
        )
        string(name: 'SNAPSHOT_CLASS',    defaultValue: '',                    description: '[2. Create VMs] VolumeSnapshotClass (empty = auto-detect)')
        string(name: 'WIN_ROOT_SIZE',     defaultValue: '100Gi',               description: '[2. Create VMs] Root disk size')
        string(name: 'WIN_DATA_SIZE',     defaultValue: '40Gi',                description: '[2. Create VMs] Blank data disk (skipped if USE_OSDISK)')

        // ----- 3. Existing hosts (CREATE_VMS=false) -----
        string(
            name: 'HOST_PATTERN',
            defaultValue: 'vm-{1..2}',
            description: '[3. Existing hosts] Pre-created VMs, e.g. winm-{1..10}. Empty when CREATE_VMS=true'
        )

        // ----- 4. Workload -----
        string(name: 'WAREHOUSE_COUNT',   defaultValue: '500',                 description: '[4. Workload] TPCC warehouse count')
        string(name: 'BUILD_USERS',       defaultValue: '100',                 description: '[4. Workload] Virtual users for schema build')
        string(name: 'USER_COUNT',        defaultValue: '1 10',                description: '[4. Workload] Space-separated user counts')
        string(name: 'TEST_DURATION',     defaultValue: '1',                   description: '[4. Workload] Test duration in minutes')
        string(name: 'MSSQL_TOTAL_ITERATIONS', defaultValue: '10000000',       description: '[4. Workload] HammerDB per-VU transaction cap (not sweep count)')
        string(
            name: 'ITERATIONS',
            defaultValue: '1',
            description: '[4. Workload] Repeat full user_count sweep N times (*_run1…*_runN via HAMMERDB_RUN)'
        )
        string(
            name: 'ITERATION_SLEEP',
            defaultValue: '60',
            description: '[4. Workload] Seconds between sweep iterations (0=off)'
        )
        string(
            name: 'VU_SLEEP',
            defaultValue: '30',
            description: '[4. Workload] Seconds between VU levels within an iteration (0=off)'
        )
        string(
            name: 'MAX_PARALLEL',
            defaultValue: '0',
            description: '[4. Workload] Max concurrent hosts (0=all hosts; positive N=cap)'
        )
        string(name: 'RAMPUP_TIME',       defaultValue: '1',                   description: '[4. Workload] Ramp-up minutes (empty = template default)')
        string(name: 'MSSQL_PASS',        defaultValue: '',                    description: '[4. Workload] MSSQL SA password')
        string(name: 'MAX_SERVER_MEMORY_MB', defaultValue: '',                 description: '[4. Workload] max server memory MB (empty = unlimited)')
        string(name: 'REBUILDDB',         defaultValue: 'true',                description: '[4. Workload] Rebuild DB before test')
        string(name: 'REBUILD_ALWAYS',    defaultValue: 'false',               description: '[4. Workload] Rebuild before every user-count')
        string(
            name: 'TEST_ONLY',
            defaultValue: 'false',
            description: '[4. Workload] Skip prepare/format and rebuild; run tests only (reuse existing TPCC DB)'
        )
        choice(
            name: 'PERFMON',
            choices: ['false', 'true'],
            description: '[4. Workload] Enable Windows PerfMon collectors (BLG + CSV under result_dir)'
        )
        string(
            name: 'PERFMON_SAMPLE_INTERVAL',
            defaultValue: '',
            description: '[4. Workload] PerfMon sample interval seconds (empty = default 5)'
        )
        string(
            name: 'PERFMON_UNTIL_ITERATION',
            defaultValue: '',
            description: '[4. Workload] Stop PerfMon after sweep iteration N (empty = all iterations)'
        )

        // ----- 5. Disk -----
        string(name: 'DISK_ID',           defaultValue: '1',                   description: '[5. Disk] Data disk ID (ignored when USE_OSDISK=true)')
        choice(
            name: 'USE_OSDISK',
            choices: ['false', 'true'],
            description: '[5. Disk] TPCC on C:\\mssql\\data (skip D: provision; create_dbC.sql)'
        )
    }

    environment {
        RESULTS_DIR  = '/root/mssqlwin-results'
        BASTION_CONN = "${params.BASTION_USER}@${params.BASTION_HOST}"
    }

    stages {
        stage('Prepare') {
            steps {
                sshagent(credentials: [params.SSH_CREDENTIAL_ID]) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${BASTION_CONN} '
                            set -e
                            mkdir -p ${RESULTS_DIR} /tmp/mssqlwin-ssh
                            podman pull ${params.CONTAINER_IMAGE} || true
                        '
                    """
                }
            }
        }

        stage('Run MSSQL Test') {
            steps {
                sshagent(credentials: [params.SSH_CREDENTIAL_ID]) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${BASTION_CONN} '
                            podman run --rm --pids-limit=-1 \
                              -e CREATE_VMS="${params.CREATE_VMS}" \
                              -e CLEANUP="${params.CLEANUP}" \
                              -e VMS="${params.VMS}" \
                              -e VM_PREFIX="${params.VM_PREFIX}" \
                              -e VM_CPU="${params.VM_CPU}" \
                              -e VM_MEMORY="${params.VM_MEMORY}" \
                              -e STORAGE_CLASS="${params.STORAGE_CLASS}" \
                              -e ACCESS_MODE="${params.ACCESS_MODE}" \
                              -e WIN_VM_IMAGE="${params.WIN_VM_IMAGE}" \
                              -e GOLDEN_SNAPSHOT="${params.GOLDEN_SNAPSHOT}" \
                              -e ORIG_VM="${params.ORIG_VM}" \
                              -e SNAPSHOT_CLASS="${params.SNAPSHOT_CLASS}" \
                              -e WIN_ROOT_SIZE="${params.WIN_ROOT_SIZE}" \
                              -e WIN_DATA_SIZE="${params.WIN_DATA_SIZE}" \
                              -e HOST_PATTERN="${params.HOST_PATTERN}" \
                              -e NAMESPACE="${params.NAMESPACE}" \
                              -e WAREHOUSE_COUNT=${params.WAREHOUSE_COUNT} \
                              -e BUILD_USERS=${params.BUILD_USERS} \
                              -e USER_COUNT="${params.USER_COUNT}" \
                              -e TEST_DURATION=${params.TEST_DURATION} \
                              -e MSSQL_TOTAL_ITERATIONS=${params.MSSQL_TOTAL_ITERATIONS} \
                              -e ITERATIONS="${params.ITERATIONS}" \
                              -e ITERATION_SLEEP="${params.ITERATION_SLEEP}" \
                              -e VU_SLEEP="${params.VU_SLEEP}" \
                              -e MAX_PARALLEL="${params.MAX_PARALLEL}" \
                              -e RAMPUP_TIME="${params.RAMPUP_TIME}" \
                              -e MSSQL_PASS="${params.MSSQL_PASS}" \
                              -e MAX_SERVER_MEMORY_MB="${params.MAX_SERVER_MEMORY_MB}" \
                              -e DISK_ID="${params.DISK_ID}" \
                              -e USE_OSDISK="${params.USE_OSDISK}" \
                              -e REBUILDDB=${params.REBUILDDB} \
                              -e REBUILD_ALWAYS=${params.REBUILD_ALWAYS} \
                              -e TEST_ONLY=${params.TEST_ONLY} \
                              -e PERFMON="${params.PERFMON}" \
                              -e PERFMON_SAMPLE_INTERVAL="${params.PERFMON_SAMPLE_INTERVAL}" \
                              -e PERFMON_UNTIL_ITERATION="${params.PERFMON_UNTIL_ITERATION}" \
                              -e DESCRIPTION="${params.DESCRIPTION}" \
                              -v ${RESULTS_DIR}:/work/results \
                              -v /tmp/mssqlwin-ssh:/host-tmp:Z \
                              -v /root/.ssh:/root/.ssh:ro \
                              -v /root/.kube/config:/root/.kube/config \
                              --privileged \
                              ${params.CONTAINER_IMAGE}
                        '
                    """
                }
            }
        }

        stage('Collect Results') {
            steps {
                sshagent(credentials: [params.SSH_CREDENTIAL_ID]) {
                    sh """
                        mkdir -p mssql-results
                        scp -o StrictHostKeyChecking=no -r \
                            ${BASTION_CONN}:${RESULTS_DIR}/ ./mssql-results/
                    """
                }
            }
        }

        stage('Archive') {
            steps {
                archiveArtifacts artifacts: 'mssql-results/**', allowEmptyArchive: true
            }
        }
    }

    post {
        success {
            echo "MSSQL test completed successfully. Results archived as build artifacts."
        }
        failure {
            echo "MSSQL test failed. Check the console output for details."
        }
        always {
            echo "Test description: ${params.DESCRIPTION}"
            echo "CREATE_VMS: ${params.CREATE_VMS} vms=${params.VMS} prefix=${params.VM_PREFIX}"
            echo "Hosts pattern: ${params.HOST_PATTERN}"
            echo "Image/snap/orig: ${params.WIN_VM_IMAGE} / ${params.GOLDEN_SNAPSHOT} / ${params.ORIG_VM}"
            echo "Warehouses: ${params.WAREHOUSE_COUNT}, Build users: ${params.BUILD_USERS}"
            echo "User counts: ${params.USER_COUNT}, Duration: ${params.TEST_DURATION}m"
            echo "Sweep iterations: ${params.ITERATIONS}, iteration_sleep=${params.ITERATION_SLEEP}s, vu_sleep=${params.VU_SLEEP}s"
            echo "Max parallel: ${params.MAX_PARALLEL}, PerfMon: ${params.PERFMON}, TEST_ONLY: ${params.TEST_ONLY}"
        }
    }
}
