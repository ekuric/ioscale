pipeline {
    agent any

    options {
        disableConcurrentBuilds()
    }

    // Parameter groups (Jenkins shows them in this order on "Build with Parameters"):
    //   1. Test        2. Bastion/cluster   3. FIO harness image
    //   4. Disk target 5. VM provision      6. Existing hosts (if not creating)
    //   7. Workload    8. Resilience/migration
    parameters {
        // ----- 1. Test identity -----
        string(
            name: 'DESCRIPTION',
            defaultValue: 'jenkins-fio-windows',
            description: '[1. Test] Run name (results dir / logs)'
        )
        string(
            name: 'NAMESPACE',
            defaultValue: 'default',
            description: '[1. Test] OpenShift namespace for VMs'
        )

        // ----- 2. Bastion / cluster -----
        choice(
            name: 'CLUSTER',
            choices: ['custom', 'lab1', 'lab2'],
            description: '[2. Bastion] Profile: custom = fields below; lab1/lab2 = built-in map in Resolve Target'
        )
        string(name: 'BASTION_HOST',      defaultValue: 'bastion.example.com', description: '[2. Bastion] Hostname/IP (CLUSTER=custom)')
        string(name: 'BASTION_USER',      defaultValue: 'root',                description: '[2. Bastion] SSH user (CLUSTER=custom)')
        string(name: 'SSH_CREDENTIAL_ID', defaultValue: 'bastion-ssh-key',     description: '[2. Bastion] Jenkins SSH credential ID (CLUSTER=custom)')
        string(name: 'API_URL',           defaultValue: 'https://api.ocp.example.com:6443', description: '[2. Bastion] Cluster API URL (CLUSTER=custom)')
        string(name: 'KUBEADMIN_PASSWORD', defaultValue: '',                   description: '[2. Bastion] Optional oc login password')

        // ----- 3. FIO harness (podman image that runs fio-tests) -----
        string(
            name: 'CONTAINER_IMAGE',
            defaultValue: 'quay.io/ekuric/fio-benchmark:latest',
            description: '[3. Harness] fio-container image (not the guest VM OS image)'
        )

        // ----- 4. Disk target mode -----
        choice(
            name: 'USE_TESTDIR',
            choices: ['false', 'true'],
            description: '[4. Disk] OS-disk FIO (c:/testdir). Mutually exclusive with USE_RAW_DISK'
        )
        choice(
            name: 'USE_RAW_DISK',
            choices: ['false', 'true'],
            description: '[4. Disk] Raw PhysicalDrive FIO. Mutually exclusive with USE_TESTDIR'
        )

        // ----- 5. On-demand VM provision -----
        choice(
            name: 'CREATE_VMS',
            choices: ['false', 'true'],
            description: '[5. Create VMs] Provision guests before FIO (leave WIN_HOST_PATTERN empty; needs STORAGE_CLASS + WIN_VM_IMAGE)'
        )
        choice(
            name: 'CLEANUP',
            choices: ['false', 'true'],
            description: '[5. Create VMs] Delete managed VMs after test (default keep; next create still wipes leftovers)'
        )
        string(name: 'WIN_VMS',              defaultValue: '3',               description: '[5. Create VMs] Number of Windows VMs')
        string(name: 'WIN_VM_PREFIX',        defaultValue: 'fio-windows',     description: '[5. Create VMs] Name prefix → fio-windows-1..N')
        string(name: 'WIN_VM_CPU',           defaultValue: '2',               description: '[5. Create VMs] vCPU cores')
        string(name: 'WIN_VM_MEMORY',        defaultValue: '4Gi',             description: '[5. Create VMs] Memory')
        string(
            name: 'WIN_VM_IMAGE',
            defaultValue: '',
            description: '[5. Create VMs] Guest OS image HTTP URL (required if CREATE_VMS)'
        )
        string(name: 'STORAGE_CLASS',        defaultValue: '',               description: '[5. Create VMs] StorageClass (required if CREATE_VMS=true)')
        string(name: 'WIN_ROOT_VOLUME_SIZE', defaultValue: '60Gi',           description: '[5. Create VMs] Root PVC size')
        string(name: 'DATA_DISK_SIZE',       defaultValue: '40Gi',           description: '[5. Create VMs] Blank data disk (skipped if USE_TESTDIR)')

        // ----- 6. Existing hosts (CREATE_VMS=false) -----
        string(
            name: 'WIN_HOST_PATTERN',
            defaultValue: '',
            description: '[6. Existing hosts] Pre-created VMs, e.g. win-vm-{1..10}. Empty when CREATE_VMS=true'
        )
        string(
            name: 'WIN_DEVICES',
            defaultValue: '',
            description: '[6. Existing hosts] pattern=diskid. Empty for testdir/create-vms'
        )

        // ----- 7. FIO workload -----
        string(name: 'WIN_TEST_SIZE',     defaultValue: '10GB',              description: '[7. Workload] Dataset / job --size')
        string(name: 'WIN_RUNTIME',       defaultValue: '300',               description: '[7. Workload] Perf runtime seconds (empty = size-based)')
        string(name: 'WIN_BLOCK_SIZES',   defaultValue: '4k 8k 128k 1024k', description: '[7. Workload] Block sizes')
        string(name: 'WIN_IO_PATTERNS',   defaultValue: 'read write randread randwrite randrw', description: '[7. Workload] I/O patterns')
        string(name: 'WIN_NUMJOBS',       defaultValue: '1',                 description: '[7. Workload] Parallel jobs')
        string(name: 'WIN_IODEPTH',       defaultValue: '16',                description: '[7. Workload] Queue depth')
        choice(name: 'WIN_DIRECT_IO',     choices: ['1', '0'],               description: '[7. Workload] Direct I/O')
        string(name: 'WIN_FSYNC',         defaultValue: '',                  description: '[7. Workload] --fsync=N (empty=off)')
        string(name: 'WIN_RATE_IOPS',     defaultValue: '',                  description: '[7. Workload] Optional IOPS cap')

        // ----- 8. Resilience / migration -----
        string(name: 'INTERVAL',            defaultValue: '30',               description: '[8. Resilience] SSH retry interval (s)')
        string(name: 'MAX_RETRIES',         defaultValue: '10',               description: '[8. Resilience] SSH max retries')
        string(name: 'MONITOR_INTERVAL',    defaultValue: '60',               description: '[8. Resilience] Task monitor interval (s)')
        string(name: 'MIGRATE_WORKLOADS',   defaultValue: '',                description: '[8. Resilience] Patterns that trigger live migrate')
        string(name: 'MIGRATE_INTERVAL',    defaultValue: '0',               description: '[8. Resilience] Seconds between migrations (0=parallel)')
        choice(name: 'MONITOR_VM',          choices: ['false', 'true'],      description: '[8. Resilience] Log VM node placement')
        string(name: 'MONITOR_VM_INTERVAL', defaultValue: '10',              description: '[8. Resilience] Placement poll interval (s)')
    }

    environment {
        RESULTS_DIR = '/root/fio-results'
    }

    stages {
        stage('Resolve Target') {
            steps {
                script {
                    def profiles = [
                        lab1: [
                            bastionHost     : 'bastion.lab1.example.com',
                            bastionUser     : 'root',
                            sshCredentialId : 'lab1-bastion-key',
                            apiUrl          : 'https://api.lab1.example.com:6443',
                            containerImage  : 'quay.io/ekuric/fio-benchmark:latest',
                        ],
                        lab2: [
                            bastionHost     : 'bastion.lab2.example.com',
                            bastionUser     : 'root',
                            sshCredentialId : 'lab2-bastion-key',
                            apiUrl          : 'https://api.lab2.example.com:6443',
                            containerImage  : 'quay.io/ekuric/fio-benchmark:latest',
                        ],
                    ]

                    if (params.CLUSTER != 'custom' && profiles.containsKey(params.CLUSTER)) {
                        def p = profiles[params.CLUSTER]
                        env.RESOLVED_BASTION_HOST      = p.bastionHost
                        env.RESOLVED_BASTION_USER      = p.bastionUser
                        env.RESOLVED_SSH_CREDENTIAL_ID = p.sshCredentialId
                        env.RESOLVED_API_URL           = p.apiUrl
                        env.RESOLVED_CONTAINER_IMAGE   = p.containerImage
                        echo "CLUSTER=${params.CLUSTER} → bastion=${p.bastionHost}, harness=${p.containerImage}"
                    } else {
                        env.RESOLVED_BASTION_HOST      = params.BASTION_HOST
                        env.RESOLVED_BASTION_USER      = params.BASTION_USER
                        env.RESOLVED_SSH_CREDENTIAL_ID = params.SSH_CREDENTIAL_ID
                        env.RESOLVED_API_URL           = params.API_URL
                        env.RESOLVED_CONTAINER_IMAGE   = params.CONTAINER_IMAGE
                        echo "CLUSTER=custom → bastion=${params.BASTION_HOST}, harness=${params.CONTAINER_IMAGE}"
                    }

                    env.BASTION_CONN = "${env.RESOLVED_BASTION_USER}@${env.RESOLVED_BASTION_HOST}"
                }
            }
        }

        stage('Prepare') {
            steps {
                sshagent(credentials: [env.RESOLVED_SSH_CREDENTIAL_ID]) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${BASTION_CONN} '
                            set -e
                            mkdir -p ${RESULTS_DIR}
                            test -s /root/.kube/config || { echo "ERROR: /root/.kube/config missing on bastion"; exit 1; }
                            oc whoami || { echo "ERROR: oc whoami failed on bastion"; exit 1; }
                            podman pull ${RESOLVED_CONTAINER_IMAGE} || true
                            podman run --rm --privileged \
                              -v /root/.kube:/root/.kube:ro,Z \
                              -e KUBECONFIG=/root/.kube/config \
                              --entrypoint bash \
                              ${RESOLVED_CONTAINER_IMAGE} \
                              -c "set -e; test -s /root/.kube/config; oc whoami; echo KUBE_OK"
                        '
                    """
                }
            }
        }

        stage('Run FIO Windows Test') {
            steps {
                sshagent(credentials: [env.RESOLVED_SSH_CREDENTIAL_ID]) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${BASTION_CONN} '
                            mkdir -p /tmp/fio-ssh
                            podman run --rm --pids-limit=-1 --privileged \
                              -e DESCRIPTION="${params.DESCRIPTION}" \
                              -e NAMESPACE="${params.NAMESPACE}" \
                              -e USE_TESTDIR="${params.USE_TESTDIR}" \
                              -e USE_RAW_DISK="${params.USE_RAW_DISK}" \
                              -e CREATE_VMS="${params.CREATE_VMS}" \
                              -e CLEANUP="${params.CLEANUP}" \
                              -e WIN_VMS="${params.WIN_VMS}" \
                              -e WIN_VM_PREFIX="${params.WIN_VM_PREFIX}" \
                              -e WIN_VM_CPU="${params.WIN_VM_CPU}" \
                              -e WIN_VM_MEMORY="${params.WIN_VM_MEMORY}" \
                              -e WIN_VM_IMAGE="${params.WIN_VM_IMAGE}" \
                              -e STORAGE_CLASS="${params.STORAGE_CLASS}" \
                              -e WIN_ROOT_VOLUME_SIZE="${params.WIN_ROOT_VOLUME_SIZE}" \
                              -e DATA_DISK_SIZE="${params.DATA_DISK_SIZE}" \
                              -e WIN_HOST_PATTERN="${params.WIN_HOST_PATTERN}" \
                              -e WIN_DEVICES="${params.WIN_DEVICES}" \
                              -e WIN_TEST_SIZE="${params.WIN_TEST_SIZE}" \
                              -e WIN_RUNTIME="${params.WIN_RUNTIME}" \
                              -e WIN_BLOCK_SIZES="${params.WIN_BLOCK_SIZES}" \
                              -e WIN_IO_PATTERNS="${params.WIN_IO_PATTERNS}" \
                              -e WIN_NUMJOBS=${params.WIN_NUMJOBS} \
                              -e WIN_IODEPTH=${params.WIN_IODEPTH} \
                              -e WIN_DIRECT_IO=${params.WIN_DIRECT_IO} \
                              -e WIN_FSYNC="${params.WIN_FSYNC}" \
                              -e WIN_RATE_IOPS="${params.WIN_RATE_IOPS}" \
                              -e MIGRATE_WORKLOADS="${params.MIGRATE_WORKLOADS}" \
                              -e MIGRATE_INTERVAL=${params.MIGRATE_INTERVAL} \
                              -e RETRY_INTERVAL=${params.INTERVAL} \
                              -e MAX_RETRIES=${params.MAX_RETRIES} \
                              -e MONITOR_INTERVAL=${params.MONITOR_INTERVAL} \
                              -e MONITOR_VM="${params.MONITOR_VM}" \
                              -e MONITOR_VM_INTERVAL=${params.MONITOR_VM_INTERVAL} \
                              -e KUBEADMIN_PASSWORD="${params.KUBEADMIN_PASSWORD}" \
                              -e API_URL="${RESOLVED_API_URL}" \
                              -e KUBECONFIG=/root/.kube/config \
                              -v ${RESULTS_DIR}:/work/results:Z \
                              -v /root/.ssh/id_rsa:/root/.ssh/id_rsa:ro,Z \
                              -v /root/.kube:/root/.kube:ro,Z \
                              -v /tmp/fio-ssh:/host-tmp:Z \
                              ${RESOLVED_CONTAINER_IMAGE}
                        '
                    """
                }
            }
        }

        stage('Collect Results') {
            steps {
                sshagent(credentials: [env.RESOLVED_SSH_CREDENTIAL_ID]) {
                    sh """
                        mkdir -p fio-results
                        scp -o StrictHostKeyChecking=no -r \
                            ${BASTION_CONN}:${RESULTS_DIR}/ ./fio-results/
                    """
                }
            }
        }

        stage('Archive') {
            steps {
                archiveArtifacts artifacts: 'fio-results/**', allowEmptyArchive: true
            }
        }
    }

    post {
        success {
            echo "FIO Windows test completed successfully. Results archived as build artifacts."
        }
        failure {
            echo "FIO Windows test failed. Check the console output for details."
        }
        always {
            echo "Test: ${params.DESCRIPTION}  ns=${params.NAMESPACE}"
            echo "Bastion: ${env.BASTION_CONN ?: '(not resolved)'}  cluster=${params.CLUSTER}"
            echo "Harness: ${env.RESOLVED_CONTAINER_IMAGE ?: params.CONTAINER_IMAGE}"
            echo "Create VMs: ${params.CREATE_VMS} count=${params.WIN_VMS} prefix=${params.WIN_VM_PREFIX} image=${params.WIN_VM_IMAGE}"
            echo "Disk: testdir=${params.USE_TESTDIR} raw=${params.USE_RAW_DISK} cleanup=${params.CLEANUP}"
            echo "Existing hosts: ${params.WIN_HOST_PATTERN ?: '(none)'}"
            echo "Workload: bs=${params.WIN_BLOCK_SIZES} patterns=${params.WIN_IO_PATTERNS} jobs=${params.WIN_NUMJOBS}"
        }
    }
}
