#!/bin/bash
#
# HammerDB MSSQL Installation Script
# This script installs HammerDB and configures MSSQL Server for TPCC testing
#
# Usage: ./Hammerdb-mssql-install-script [-h] [-d disk_device] [-m mount_point]
#
# Options:
#   -h              Show this help message
#   -d <device>     Block device to format and mount (e.g., /dev/sdb)
#   -m <mountpoint> Existing mount point to use (e.g., /perf1)
#
# Examples:
#   ./Hammerdb-mssql-install-script -d '/dev/sdb'
#   ./Hammerdb-mssql-install-script -m '/perf1'

set -euo pipefail  # Exit on error, undefined vars, pipe failures

# ============================================================================
# Configuration Variables
# ============================================================================
DISKS="none"
MOUNTPOINT="none"
HAMMERDB_PATH="/root/hammerdb-tpcc-wrapper-scripts"
HAMMERDB_INSTALL_DIR="/usr/local/HammerDB"
MSSQL_SA_PASSWORD="mssqlpasswd1!"
MSSQL_PID="Evaluation"
DEFAULT_MOUNTPOINT="/perf1"
MSSQL_DATA_DIR="/var/opt/mssql"

# ============================================================================
# Functions
# ============================================================================

usage() {
    cat << EOF
Usage: $0 [-h] [-d disk_device] [-m mount_point]

Options:
    -h              Show this help message
    -d <device>     Block device to format and mount (e.g., /dev/sdb)
    -m <mountpoint> Existing mount point to use (e.g., /perf1)

Examples:
    $0 -d '/dev/sdb'
    $0 -m '/perf1'

Note: Either -d or -m must be specified, but not both.
EOF
}

error_exit() {
    echo "ERROR: $1" >&2
    exit 1
}

log_info() {
    echo "[INFO] $1"
}

log_step() {
    echo ""
    echo "============================================================================"
    echo "STEP: $1"
    echo "============================================================================"
}

# ============================================================================
# Parse Command Line Arguments
# ============================================================================

if [ $# -eq 0 ]; then
    usage
    exit 1
fi

while [ $# -gt 0 ]; do
    case $1 in
        -h|--help)
            usage
            exit 0
            ;;
        -d)
            DISKS="$2"
            shift 2
            ;;
        -m)
            MOUNTPOINT="$2"
            shift 2
            ;;
        *)
            echo "ERROR: Unknown option: $1" >&2
            usage
            exit 1
            ;;
    esac
done

# Validate arguments
if [[ "$MOUNTPOINT" == "none" && "$DISKS" == "none" ]]; then
    error_exit "Either -d (disk device) or -m (mount point) must be specified"
fi

if [[ "$MOUNTPOINT" != "none" && "$DISKS" != "none" ]]; then
    error_exit "Cannot specify both -d and -m options. Use either disk device or mount point."
fi

# ============================================================================
# Main Installation Process
# ============================================================================

log_step "Starting MSSQL Server and HammerDB Installation"

# ----------------------------------------------------------------------------
# Step 1: Disable SELinux
# ----------------------------------------------------------------------------
log_step "Disabling SELinux"
setenforce 0 || log_info "SELinux already disabled or not available"

# ----------------------------------------------------------------------------
# Step 2: Stop Existing MSSQL Server Service (if any)
# ----------------------------------------------------------------------------
log_step "Stopping Existing MSSQL Server Service"
log_info "Stopping MSSQL Server..."
systemctl stop mssql-server || log_info "MSSQL Server was not running"

# ----------------------------------------------------------------------------
# Step 3: Install HammerDB
# ----------------------------------------------------------------------------
log_step "Installing HammerDB"

if [ ! -d "${HAMMERDB_PATH}/templates/mssql" ]; then
    error_exit "HammerDB templates directory not found: ${HAMMERDB_PATH}/templates/mssql"
fi

cd "${HAMMERDB_PATH}/templates/mssql" || error_exit "Cannot change to HammerDB templates directory"

if [ ! -f "hammerdb-tpcc.tar" ]; then
    error_exit "HammerDB tar archive not found: hammerdb-tpcc.tar"
fi

log_info "Extracting and installing HammerDB from hammerdb-tpcc.tar..."
tar xf hammerdb-tpcc.tar || error_exit "Failed to extract hammerdb-tpcc.tar"
rm -rf "${HAMMERDB_INSTALL_DIR}"
mv HammerDB-* "${HAMMERDB_INSTALL_DIR}" || error_exit "Failed to move HammerDB to ${HAMMERDB_INSTALL_DIR}"
echo "${HAMMERDB_INSTALL_DIR}/lib" > /etc/ld.so.conf.d/hammerdb.conf
ldconfig

cat > /usr/local/bin/hammerdbcli << 'WEOF'
#!/bin/bash
cd /usr/local/HammerDB
exec bash ./hammerdbcli "$@"
WEOF
chmod +x /usr/local/bin/hammerdbcli

log_info "Setting TMP/TEMP environment variables for HammerDB..."
grep -q '^TMP=' /etc/environment 2>/dev/null || echo 'TMP=/tmp' >> /etc/environment
grep -q '^TEMP=' /etc/environment 2>/dev/null || echo 'TEMP=/tmp' >> /etc/environment
export TMP=/tmp
export TEMP=/tmp

log_info "Verifying HammerDB installation..."
hammerdbcli <<< "exit" 2>&1 | head -3 || log_info "Warning: HammerDB CLI verification returned non-zero (may still work)"
log_info "HammerDB installed to ${HAMMERDB_INSTALL_DIR}"

# ----------------------------------------------------------------------------
# Step 4: Install MSSQL Server Packages
# ----------------------------------------------------------------------------
log_step "Installing MSSQL Server Packages"

log_info "Configuring Microsoft repositories..."
curl -f https://packages.microsoft.com/rhel/9/mssql-server-2022/config.repo -o /etc/yum.repos.d/mssql-server-2022.repo || \
    error_exit "Failed to download MSSQL Server repository"
curl -f https://packages.microsoft.com/config/rhel/9/prod.repo -o /etc/yum.repos.d/mssql-prod.repo || \
    error_exit "Failed to download Microsoft prod repository"

log_info "Removing conflicting unixODBC packages..."
dnf -y remove unixODBC-utf16 unixODBC-utf16-devel 2>/dev/null || true

log_info "Installing MSSQL Server, tools, and ODBC driver..."
ACCEPT_EULA=Y dnf -y install mssql-server mssql-tools18 msodbcsql18 unixODBC-devel iproute || \
    error_exit "Failed to install MSSQL packages"

log_info "Verifying ODBC Driver 18 is installed..."
if odbcinst -q -d 2>/dev/null | grep -q "ODBC Driver 18"; then
    log_info "ODBC Driver 18 for SQL Server is installed"
else
    log_info "Warning: ODBC Driver 18 not found in odbcinst - HammerDB may fail to connect"
fi

log_info "Adding MSSQL tools to PATH..."
MSSQL_TOOLS_DIR="/opt/mssql-tools18/bin"
if [ ! -d "${MSSQL_TOOLS_DIR}" ]; then
    MSSQL_TOOLS_DIR="/opt/mssql-tools/bin"
fi
if ! grep -q "${MSSQL_TOOLS_DIR}" ~/.bash_profile 2>/dev/null; then
    echo "export PATH=\"\$PATH:${MSSQL_TOOLS_DIR}\"" >> ~/.bash_profile
fi
if [ -f "${MSSQL_TOOLS_DIR}/bcp" ]; then
    ln -sf "${MSSQL_TOOLS_DIR}/bcp" "/usr/local/bin/bcp"
    log_info "Created symlink: /usr/local/bin/bcp -> ${MSSQL_TOOLS_DIR}/bcp"
fi

log_info "Creating sqlcmd wrapper with -C (trust server certificate) for ODBC Driver 18..."
cat > /usr/local/bin/sqlcmd << SQLEOF
#!/bin/bash
exec ${MSSQL_TOOLS_DIR}/sqlcmd -C "\$@"
SQLEOF
chmod +x /usr/local/bin/sqlcmd

if [ "${MSSQL_TOOLS_DIR}" != "/opt/mssql-tools/bin" ]; then
    log_info "Creating legacy /opt/mssql-tools/bin symlinks for compatibility..."
    mkdir -p /opt/mssql-tools/bin
    ln -sf /usr/local/bin/sqlcmd /opt/mssql-tools/bin/sqlcmd
    ln -sf "${MSSQL_TOOLS_DIR}/bcp" /opt/mssql-tools/bin/bcp
fi

# ----------------------------------------------------------------------------
# Step 5: Copy MSSQL Setup Files
# ----------------------------------------------------------------------------
log_step "Copying MSSQL Configuration Files"

cd "${HAMMERDB_INSTALL_DIR}" || error_exit "Cannot change to HammerDB install directory"

if [ -d "${HAMMERDB_PATH}/templates/mssql/mssqlsetup" ]; then
    log_info "Copying mssqlsetup files..."
    cp "${HAMMERDB_PATH}/templates/mssql/mssqlsetup/"* . 2>/dev/null || \
        log_info "Warning: Some files may not have been copied"
else
    log_info "Warning: mssqlsetup directory not found, skipping file copy"
fi

# ----------------------------------------------------------------------------
# Step 6: Setup Storage (Disk Formatting or Mount Point)
# ----------------------------------------------------------------------------
log_step "Setting Up Storage"

if [[ "$MOUNTPOINT" == *"none"* ]]; then
    # Using disk device option - format and mount
    log_info "Using disk device option: ${DISKS}"
    
    if [ ! -b "${DISKS}" ]; then
        error_exit "Disk device ${DISKS} does not exist or is not a block device"
    fi
    
    # Check if device is mounted anywhere and unmount it
    log_info "Checking if ${DISKS} is mounted..."
    MOUNTED_AT=$(findmnt -n -o TARGET --source "${DISKS}" 2>/dev/null || true)
    if [ -n "${MOUNTED_AT}" ]; then
        log_info "Device ${DISKS} is mounted at ${MOUNTED_AT}, unmounting..."
        umount "${MOUNTED_AT}" 2>/dev/null || {
            log_info "Regular unmount failed, trying lazy unmount..."
            umount -l "${MOUNTED_AT}" 2>/dev/null || log_info "Lazy unmount also failed, continuing anyway"
        }
        # Wait a moment for unmount to complete
        sleep 2
        # Verify it's unmounted
        if findmnt -n -o TARGET --source "${DISKS}" >/dev/null 2>&1; then
            error_exit "Failed to unmount ${DISKS} - device is still mounted"
        fi
        log_info "Successfully unmounted ${DISKS} from ${MOUNTED_AT}"
    else
        log_info "Device ${DISKS} is not currently mounted"
    fi
    
    # Also try to unmount /perf1 if it exists (in case it's a different device)
    if mountpoint -q /perf1 2>/dev/null; then
        log_info "Unmounting /perf1 (may be a different device)..."
        umount /perf1 2>/dev/null || log_info "Could not unmount /perf1 (may not be ${DISKS})"
    fi
    
    log_info "Formatting disk ${DISKS} with XFS..."
    mkfs.xfs -f "${DISKS}" || error_exit "Failed to format disk ${DISKS}"
    
    log_info "Creating mount point..."
    mkdir -p "${DEFAULT_MOUNTPOINT}" || error_exit "Failed to create mount point"
    
    log_info "Mounting ${DISKS} to ${DEFAULT_MOUNTPOINT}..."
    mount "${DISKS}" "${DEFAULT_MOUNTPOINT}" || error_exit "Failed to mount ${DISKS}"
    
    MOUNTPOINT="${DEFAULT_MOUNTPOINT}"
else
    # Using existing mount point
    log_info "Using mount point option: ${MOUNTPOINT}"
    
    if [ ! -d "${MOUNTPOINT}" ]; then
        error_exit "Mount point directory does not exist: ${MOUNTPOINT}"
    fi
fi

# ----------------------------------------------------------------------------
# Step 7: Create MSSQL Data Directory
# ----------------------------------------------------------------------------
log_step "Creating MSSQL Data Directory"

log_info "Stopping MSSQL Server before data directory setup..."
systemctl stop mssql-server || log_info "MSSQL Server was not running"

log_info "Removing existing MSSQL data directories..."
rm -rf "${MOUNTPOINT}/mssql_data" 2>/dev/null || log_info "No existing mssql_data directory to remove"
rm -rf "${MSSQL_DATA_DIR}" 2>/dev/null || log_info "No existing ${MSSQL_DATA_DIR} directory to remove"

log_info "Creating MSSQL data directory..."
mkdir -p "${MOUNTPOINT}/mssql_data" || error_exit "Failed to create MSSQL data directory"

log_info "Setting permissions on MSSQL data directory..."
chmod 777 /var/opt 2>/dev/null || log_info "Could not set permissions on /var/opt"
chown -R mssql:mssql "${MOUNTPOINT}/mssql_data" || error_exit "Failed to set ownership"

# ----------------------------------------------------------------------------
# Step 8: Configure MSSQL Server
# ----------------------------------------------------------------------------
log_step "Configuring MSSQL Server"

log_info "Creating MSSQL secrets directory..."
mkdir -p "${MSSQL_DATA_DIR}/secrets/" || error_exit "Failed to create secrets directory"

log_info "Setting MSSQL environment variables..."
export MSSQL_SA_PASSWORD="${MSSQL_SA_PASSWORD}"
export MSSQL_PID="${MSSQL_PID}"

cd /opt/mssql/bin/ || error_exit "Cannot change to MSSQL bin directory"

log_info "Running MSSQL configuration setup..."
echo "1" > input
echo "Yes" >> input
echo "${MSSQL_SA_PASSWORD}" >> input
echo "${MSSQL_SA_PASSWORD}" >> input

./mssql-conf -n setup accept-eula < input || error_exit "MSSQL configuration setup failed"

log_info "Waiting for MSSQL configuration to complete..."
RETRY=0
while [ $RETRY -lt 12 ]; do
    if systemctl is-active --quiet mssql-server 2>/dev/null && \
       ss -tln | grep -q ':1433 '; then
        log_info "MSSQL Server is running after setup (port 1433 listening)"
        break
    fi
    RETRY=$((RETRY + 1))
    sleep 5
done

log_info "Stopping MSSQL Server to move data directory..."
systemctl stop mssql-server || log_info "MSSQL Server was not running"

# ----------------------------------------------------------------------------
# Step 9: Move MSSQL Data to Mount Point
# ----------------------------------------------------------------------------
log_step "Moving MSSQL Data Directory"

if [ -d "${MSSQL_DATA_DIR}/data" ]; then
    log_info "Moving MSSQL data directory to ${MOUNTPOINT}/mssql_data/data..."
    mv "${MSSQL_DATA_DIR}/data" "${MOUNTPOINT}/mssql_data/data" || \
        error_exit "Failed to move MSSQL data directory"
    
    log_info "Creating symbolic link from ${MSSQL_DATA_DIR}/data to ${MOUNTPOINT}/mssql_data/data..."
    ln -sf "${MOUNTPOINT}/mssql_data/data" "${MSSQL_DATA_DIR}/data" || \
        error_exit "Failed to create symbolic link"
else
    log_info "MSSQL data directory not found, creating new one..."
    mkdir -p "${MOUNTPOINT}/mssql_data/data" || error_exit "Failed to create MSSQL data directory"
    chown -R mssql:mssql "${MOUNTPOINT}/mssql_data" || error_exit "Failed to set ownership"
    ln -sf "${MOUNTPOINT}/mssql_data/data" "${MSSQL_DATA_DIR}/data" || \
        error_exit "Failed to create symbolic link"
fi

# ----------------------------------------------------------------------------
# Step 10: Configure MSSQL Settings
# ----------------------------------------------------------------------------
log_step "Configuring MSSQL Settings"

cd "${HAMMERDB_INSTALL_DIR}" || error_exit "Cannot change to HammerDB install directory"

if [ -f "mssql.conf" ]; then
    log_info "Updating MSSQL configuration..."
    # Add FUA Traceflag if not already present
    if ! grep -q "Traceflag15 = 3982" mssql.conf 2>/dev/null; then
        echo "Traceflag15 = 3982" >> mssql.conf
        log_info "Added FUA Traceflag to configuration"
    fi
    
    # Update Writethrough setting
    sed -i "s/^Writethrough.*/Writethrough = 1/" mssql.conf || \
        log_info "Warning: Failed to update Writethrough setting"
    
    log_info "Copying MSSQL configuration to ${MSSQL_DATA_DIR}/mssql.conf..."
    cp mssql.conf "${MSSQL_DATA_DIR}/mssql.conf" || \
        log_info "Warning: Failed to copy MSSQL configuration"
else
    log_info "Warning: mssql.conf not found, creating default configuration..."
    cat > "${MSSQL_DATA_DIR}/mssql.conf" << EOF
Traceflag15 = 3982
Writethrough = 1
EOF
fi

# ----------------------------------------------------------------------------
# Step 11: Start MSSQL Server
# ----------------------------------------------------------------------------
log_step "Starting MSSQL Server"

log_info "Disabling MSSQL Server service (will be started manually)..."
systemctl disable mssql-server.service || log_info "Warning: Failed to disable service"

log_info "Starting MSSQL Server..."
systemctl restart mssql-server.service || error_exit "Failed to start MSSQL Server"

log_info "Waiting for MSSQL Server to be ready..."
RETRY_COUNT=0
MAX_RETRIES=30
while [ $RETRY_COUNT -lt $MAX_RETRIES ]; do
    if systemctl is-active --quiet mssql-server 2>/dev/null && \
       ss -tln | grep -q ':1433 '; then
        log_info "MSSQL Server is ready (port 1433 accepting connections)"
        break
    fi
    RETRY_COUNT=$((RETRY_COUNT + 1))
    if [ $((RETRY_COUNT % 5)) -eq 0 ]; then
        log_info "Waiting for MSSQL Server to be ready... (attempt $RETRY_COUNT/$MAX_RETRIES)"
    fi
    sleep 5
done

if [ $RETRY_COUNT -eq $MAX_RETRIES ]; then
    log_info "Warning: MSSQL Server may not be fully ready, attempting database creation anyway"
fi

# ----------------------------------------------------------------------------
# Step 12: Create MSSQL Database
# ----------------------------------------------------------------------------
log_step "Creating MSSQL Database"

cd "${HAMMERDB_INSTALL_DIR}" || error_exit "Cannot change to HammerDB install directory"

if [ -f "createdb_mssql_mnt.sh" ]; then
    log_info "Running database creation script..."
    ./createdb_mssql_mnt.sh -m "${MOUNTPOINT}" > crdb.out 2>&1 || \
        log_info "Warning: Database creation script may have encountered issues - check crdb.out"
else
    log_info "Warning: createdb_mssql_mnt.sh not found, skipping database creation"
fi

if [ -f "update_temp_mnt.sh" ]; then
    log_info "Running tempdb update script..."
    ./update_temp_mnt.sh -m "${MOUNTPOINT}" > upd_tmp.out 2>&1 || \
        log_info "Warning: TempDB update script may have encountered issues - check upd_tmp.out"
else
    log_info "Warning: update_temp_mnt.sh not found, skipping tempdb update"
fi

# ----------------------------------------------------------------------------
# Installation Complete
# ----------------------------------------------------------------------------
log_step "Installation Complete"

log_info "MSSQL Server and HammerDB installation completed successfully!"
log_info "MSSQL data directory: ${MOUNTPOINT}/mssql_data/data (linked to ${MSSQL_DATA_DIR}/data)"
log_info "HammerDB installation: ${HAMMERDB_INSTALL_DIR}"
log_info "MSSQL SA password: ${MSSQL_SA_PASSWORD}"
log_info "MSSQL Product ID: ${MSSQL_PID}"

exit 0
